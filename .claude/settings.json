{
  "mcpServers": {
    "SellessMCP": {
      "command": "uv",
      "args": ["run", "python", "-m", "src.selless_mcp.server"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}",
        "SELLESS_API_BASE_URL": "${SELLESS_API_BASE_URL}"
      }
    },
    "ReplyMCP": {
      "command": "uv",
      "args": ["run", "python", "-m", "src.reply_mcp.server"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/hooks/injection_screen.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/hooks/pii_redact.py"
          }
        ]
      }
    ]
  },
  "env": {
    "SEND_MODE": "dry_run"
  }
}
