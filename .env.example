# Database
DATABASE_URL=postgresql://csbot:csbot@localhost:5432/csbot

# Freshdesk
FRESHDESK_DOMAIN=yourcompany
FRESHDESK_API_KEY=

# Webhook
WEBHOOK_SECRET=

# Send mode: dry_run (default) or live
SEND_MODE=dry_run

# Selless sync origin user IDs (comma-separated integers, e.g. "42,99")
SELLESS_SYNC_USER_IDS=

# Per-ticket reply throttle (prevents duplicate sends within time window)
PER_TICKET_REPLY_THROTTLE_N=1
PER_TICKET_REPLY_THROTTLE_WINDOW_MINUTES=30
